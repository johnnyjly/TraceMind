# Application
TRACEMIND_ENVIRONMENT=development

# MCP is the default query path. Server backend URLs are configured separately
# in services/otel-telemetry-mcp/.env.example or its Docker Compose layer.
TRACEMIND_TELEMETRY_TRANSPORT=mcp
TRACEMIND_TELEMETRY_MCP_URL=http://127.0.0.1:8012/mcp
# Decoded MCP reply cap, separate from the run's retained evidence byte budget.
TRACEMIND_TELEMETRY_MCP_RESPONSE_BYTES=16777216

# Primary model: choose google, openai, or deepseek and set its matching key.
# Example diagnostic profile: Pro primary, Flash fallback; Judge configured separately.
# Never commit real API keys; keep them in the ignored .env file.
TRACEMIND_LLM_PROVIDER=deepseek
TRACEMIND_LLM_MODEL=deepseek-v4-pro
TRACEMIND_GOOGLE_API_KEY=
TRACEMIND_OPENAI_API_KEY=
TRACEMIND_DEEPSEEK_API_KEY=

# Fallback profile: configure BOTH fields and set that provider's key above.
TRACEMIND_AGENT_FALLBACK_PROVIDER=deepseek
TRACEMIND_AGENT_FALLBACK_MODEL=deepseek-flash

# Context and evidence: example run limits, not model capacity.
# Input estimate = serialized UTF-8 bytes + framing; actual usage is logged
# separately. Output is reserved from the total context allowance.
# Compression uses stored indexes and bounded previews; no summary LLM is used.
TRACEMIND_AGENT_CONTEXT_TOKENS=131072
TRACEMIND_AGENT_OUTPUT_TOKENS=8192
TRACEMIND_AGENT_OBSERVATION_BYTES=8388608

# Loop limits: retries also consume these budgets. Recursion counts graph
# steps, not model calls; keep it large enough for model/tool alternation.
# Tool/repetition/no-progress limits close investigation. Final diagnosis
# uses the remaining model/time/context budgets; no extra allowance is added.
TRACEMIND_AGENT_RECURSION_LIMIT=50
TRACEMIND_AGENT_MAX_MODEL_CALLS=15
TRACEMIND_AGENT_MAX_TOOL_CALLS=25
TRACEMIND_AGENT_MAX_IDENTICAL_TOOL_CALLS=2
TRACEMIND_AGENT_NO_PROGRESS_ROUNDS=3
TRACEMIND_AGENT_DIAGNOSIS_REPAIRS=1

# Deadlines and per-attempt timeouts (seconds)
TRACEMIND_AGENT_TIMEOUT_SECONDS=300
TRACEMIND_AGENT_MODEL_TIMEOUT_SECONDS=60
TRACEMIND_AGENT_TOOL_TIMEOUT_SECONDS=20

# Recovery: additional attempts after the first failure, with capped backoff.
TRACEMIND_AGENT_RETRY_ATTEMPTS=2
TRACEMIND_AGENT_RETRY_BACKOFF_SECONDS=0.25
TRACEMIND_AGENT_RETRY_MAX_BACKOFF_SECONDS=4

# Tool grants: JSON array of names, including any explicitly authorized MCP
# tools. Discovery never grants access. read_evidence retrieves retained
# details; explanation runs use authorized retained-data readers only.
TRACEMIND_AGENT_ALLOWED_TOOLS=["query_metrics","discover_metrics","search_traces","get_trace_detail","search_logs","read_evidence"]

# Persistence and detailed traces
TRACEMIND_AGENT_TRACE_DIRECTORY=artifacts/runs
TRACEMIND_AGENT_RUN_DATABASE=artifacts/runs.sqlite3
TRACEMIND_AGENT_CHECKPOINT_DATABASE=artifacts/checkpoints.sqlite3

# S6: feedback learning, preferences/skills and confirmed incident experience.
# Stored in the run database; follow-up learning shares the diagnosis call.
# Environment and version must identify the actual telemetry deployment;
# change version after relevant code/config changes. These are not credentials.
TRACEMIND_AGENT_MEMORY_ENABLED=false
# TRACEMIND_AGENT_MEMORY_ENVIRONMENT=otel-demo-local
# TRACEMIND_AGENT_MEMORY_DEPLOYMENT_VERSION=demo-3.1.0-local-v1
TRACEMIND_AGENT_MEMORY_MAX_RECORDS=3
TRACEMIND_AGENT_MEMORY_CONTEXT_BYTES=4096
# TTL for automatically confirmed diagnoses; preferences/skills have no TTL.
TRACEMIND_AGENT_MEMORY_AUTO_EXPIRY_DAYS=30

# Optional online knowledge: disabled for the single-agent baseline.
# Enable only with a published snapshot and explicit search_knowledge and
# read_knowledge names added to AGENT_ALLOWED_TOOLS above. No automatic grants.
TRACEMIND_AGENT_KNOWLEDGE_ENABLED=false
# TRACEMIND_AGENT_KNOWLEDGE_SNAPSHOT=runbooks-v2
TRACEMIND_AGENT_KNOWLEDGE_MAX_REFERENCES=20
TRACEMIND_AGENT_KNOWLEDGE_RETENTION_BYTES=262144
TRACEMIND_AGENT_KNOWLEDGE_CONTEXT_BYTES=8192
TRACEMIND_AGENT_KNOWLEDGE_MAX_QUERIES=3
# Online retention and auxiliary-output caps, independently of CLI RAG limits.
TRACEMIND_AGENT_KNOWLEDGE_RESULT_LIMIT=5
TRACEMIND_AGENT_KNOWLEDGE_MODEL_OUTPUT_TOKENS=2048
# Leave this many main-model calls after each auxiliary attempt, including retries.
# Set 2 to also reserve one diagnosis repair; this does not add extra budget.
TRACEMIND_AGENT_KNOWLEDGE_RESERVED_MODEL_CALLS=1

# Optional RAG infrastructure: uv sync --extra rag.
# Separate CLI workspace; retrieval experiments use the same Langfuse platform.
# Download model weights explicitly with: uv run --extra rag python scripts/rag.py models
# Inference uses cached models only. Never commit model caches or indexes.
TRACEMIND_RAG_DIRECTORY=artifacts/rag
# Optional shared cache for independent worktrees; snapshots stay in DIRECTORY.
# TRACEMIND_RAG_MODEL_CACHE_DIRECTORY=artifacts/rag/models
TRACEMIND_RAG_SNAPSHOT=published-snapshot-id
TRACEMIND_RAG_QDRANT_URL=http://127.0.0.1:6333
TRACEMIND_RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
TRACEMIND_RAG_EMBEDDING_REVISION=5c38ec7c405ec4b44b94cc5a9bb96e735b38267a
TRACEMIND_RAG_EMBEDDING_DIMENSION=384
TRACEMIND_RAG_EMBEDDING_MAX_TOKENS=512
TRACEMIND_RAG_EMBEDDING_QUERY_PREFIX="Represent this sentence for searching relevant passages: "
TRACEMIND_RAG_RERANKER_MODEL=BAAI/bge-reranker-base
TRACEMIND_RAG_RERANKER_REVISION=2cfc18c9415c912f9d8155881c133215df768a70
TRACEMIND_RAG_RERANKER_MAX_TOKENS=512
TRACEMIND_RAG_DEVICE=cpu
TRACEMIND_RAG_BATCH_SIZE=8
TRACEMIND_RAG_CHUNK_TOKENS=320
# Docling structural chunks use no sliding-window overlap. New parser => new ID.
# standard: local layout/table models, no OCR. native: text only, no layout model.
TRACEMIND_RAG_PDF_PIPELINE=standard
TRACEMIND_RAG_MODE=mix
TRACEMIND_RAG_CANDIDATE_LIMIT=20
TRACEMIND_RAG_RESULT_LIMIT=5
TRACEMIND_RAG_BM25_ENABLED=true
# CLI/application assemble the callback. Omit BOTH to use the primary model.
# To use a separate model, set BOTH plus that provider's application key above.
# TRACEMIND_RAG_LLM_PROVIDER=...
# TRACEMIND_RAG_LLM_MODEL=...
TRACEMIND_RAG_LLM_MAX_CALLS=4
TRACEMIND_RAG_LLM_OUTPUT_TOKENS=2048
TRACEMIND_RAG_TIMEOUT_SECONDS=60
TRACEMIND_RAG_RETRIEVAL_CONTEXT_TOKENS=8192
TRACEMIND_RAG_SUMMARY_MAX_TOKENS=192
TRACEMIND_RAG_SUMMARY_LENGTH_RECOMMENDED=128

# Optional reranker cutoff; recalibrate when snapshot or model changes.
# Unset by default; use a score validated against your published snapshot.
# TRACEMIND_RAG_RERANK_MIN_SCORE=

# Prewarmed retrieval service; start scripts/run_rag_service.py first.
TRACEMIND_RAG_SERVICE_URL=http://127.0.0.1:8011
TRACEMIND_RAG_SERVICE_QUERY_TIMEOUT=15
# Langfuse is the only evaluation platform. Normal diagnosis tracing is opt-in.
# Local bootstrap: python scripts/setup_langfuse.py (keys stay ignored).
TRACEMIND_LANGFUSE_ENABLED=false
TRACEMIND_LANGFUSE_BASE_URL=http://127.0.0.1:3000
TRACEMIND_LANGFUSE_PUBLIC_KEY=
TRACEMIND_LANGFUSE_SECRET_KEY=
TRACEMIND_EVAL_JUDGE_PROVIDER=deepseek
TRACEMIND_EVAL_JUDGE_MODEL=deepseek-v4-pro
TRACEMIND_EVAL_JUDGE_TIMEOUT_SECONDS=60
TRACEMIND_EVAL_JUDGE_INPUT_BYTES=65536
TRACEMIND_EVAL_JUDGE_OUTPUT_TOKENS=4096

# Online completion check: one tool-free call in the shared run budget.
# Unsupported claims yield inconclusive; review failures cannot yield complete.
TRACEMIND_VERIFIER_ENABLED=true
TRACEMIND_VERIFIER_PROVIDER=deepseek
TRACEMIND_VERIFIER_MODEL=deepseek-v4-pro
TRACEMIND_VERIFIER_TIMEOUT_SECONDS=60
TRACEMIND_VERIFIER_INPUT_BYTES=131072
TRACEMIND_VERIFIER_OUTPUT_TOKENS=4096
