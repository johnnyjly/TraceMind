# Pass these variables to the service process; it does not automatically load
# any .env file. Docker Compose provides container backend addresses separately.
TELEMETRY_MCP_PROMETHEUS_URL=http://localhost:9090
TELEMETRY_MCP_JAEGER_URL=http://localhost:16686/jaeger/ui
TELEMETRY_MCP_OPENSEARCH_URL=http://localhost:9200
TELEMETRY_MCP_OPENSEARCH_LOGS_INDEX=otel-logs-*
TELEMETRY_MCP_TIMEOUT_SECONDS=20
TELEMETRY_MCP_RESPONSE_BYTES=16777216
TELEMETRY_MCP_HOST=127.0.0.1
TELEMETRY_MCP_PORT=8012
TELEMETRY_MCP_ALLOWED_HOSTS=["localhost:*","127.0.0.1:*","telemetry-mcp:*"]
TELEMETRY_MCP_ALLOWED_ORIGINS=["http://localhost:*","http://127.0.0.1:*"]
