  {
    "name": "get_trace_detail",
    "description": "Inspect a known trace: return error spans plus up to 20 longest successful spans, including service, operation, duration_ms, is_error and parent_span_id when available. Use successful spans to investigate latency even when there are no errors. Parent and child durations overlap; do not sum them. Results are bounded, not a complete span tree. This tool does not filter by time.\n\nUse the exact attributes.trace_id from trace or log evidence, not the evidence's id. If no trace ID is available, search_traces or search_logs may supply one when those tools are available. Do not invent a trace ID or reconstruct an abbreviated value.",
    "inputSchema": {
      "additionalProperties": false,
      "description": "Require an actual Jaeger trace ID rather than an evidence UUID.",
      "properties": {
        "trace_id": {
          "pattern": "^(?:[0-9a-fA-F]{16}|[0-9a-fA-F]{32})$",
          "title": "Trace Id",
          "type": "string",
          "description": "Copy the exact attributes.trace_id from returned trace or log evidence: a 16 or 32 character hexadecimal Jaeger ID. Not an evidence UUID or span_id. Never invent or pad an ID."
        }
      },
      "required": [
        "trace_id"
