  {
    "name": "search_logs",
    "description": "Find OpenSearch logs for one service in the supplied start/end window, optionally matching text. Results are a bounded sample; use the exact observed telemetry service name. If a filtered search is empty or fails to explain the observed operation, inspect one unfiltered sample for that service in the same window, unless already inspected. Do not cycle through guessed service names or assume the cause must appear at error severity. absence of a message does not prove absence of a fault. Event time is preferred; when it is absent or zero, observation time is used, marked by timestamp_source=observedTimestamp in evidence. Observation time is not proof of the exact event occurrence time.",
    "inputSchema": {
      "additionalProperties": false,
      "description": "Select service logs with an optional body-text filter.",
      "properties": {
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string",
          "x-investigation-context": "start"
        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string",
          "x-investigation-context": "end"
        },
        "service": {
          "title": "Service",
          "type": "string",
          "description": "Exact telemetry service name. Not an operation name or a list of services."
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text",
          "description": "Optional log-body search terms. Omit or use null to apply no body-text filter. Not a trace ID filter or a regex."
