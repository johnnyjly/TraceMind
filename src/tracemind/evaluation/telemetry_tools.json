  {
    "name": "search_traces",
    "description": "Find recent Jaeger traces for one service in the supplied start/end window. Copy an observed telemetry service name; do not derive it from an RPC class name or guess spelling variants. Returned attributes.services lists actual service names from the in-window spans of that trace (possibly incomplete). Use those names for downstream queries. Inspect a promising trace before searching every service; repeated trace details may add no evidence. Use min_duration_ms for slow spans or errors_only for error-tagged spans; filters run before the backend result limit. Empty searches return bounded global service-name hints without evidence IDs. Those names do not establish activity in the incident window. This is a bounded recent sample, not the slowest or failing traces across the whole window. If frontend samples do not show the reported fault, search the suspected downstream service using its observed name. For latency, inspect slow downstream spans before spending the budget on broad metric discovery. A normal recent sample cannot exclude intermittent failures.",
    "inputSchema": {
      "additionalProperties": false,
      "description": "Select one service's trace summaries.",
      "properties": {
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string",
          "x-investigation-context": "start"
        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string",
          "x-investigation-context": "end"
        },
        "service": {
          "title": "Service",
          "type": "string"
        },
        "min_duration_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Duration Ms",
          "description": "Optional positive minimum matching span duration in milliseconds. Not whole-trace duration; omit or use null for no duration filter."
        },
        "errors_only": {
          "default": false,
          "title": "Errors Only",
          "type": "boolean",
          "description": "Match indexed error=true span tags when true. Does not cover failures without this tag. Combined with duration using AND."
        }
      },
      "required": [
        "start",
        "end",
        "service"
      ],
      "title": "TraceSearch",
      "type": "object"
    },
