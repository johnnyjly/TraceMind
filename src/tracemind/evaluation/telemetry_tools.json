[
  {
    "name": "query_metrics",
    "description": "Query an instant vector at the supplied at timestamp. Use when sample values are needed to check a hypothesis. Reuse confirmed metric names and labels; discover_metrics, if available, can find unknown names and labels. Skip queries when existing evidence already answers the question.\n\nReturns normalized observations with evidence IDs, or an empty evidence list when no samples match. An empty result does not establish health: check names, labels and sample availability before retrying. Do not guess names or label variants.\n\nCounters and histogram buckets are cumulative, not counts within the incident window. For a windowed claim, use rate or increase with a range inside that window and enough samples. Buckets are cumulative across le boundaries too. Compare matching labels, units and cohorts; do not infer a specific connection failure from unrelated memory or traffic counters.\n\nConditional example: ONLY if request_count_total and the label job=\"orders\" are confirmed, the expression 'request_count_total{job=\"orders\"}' can inspect those samples.",
    "inputSchema": {
      "additionalProperties": false,
      "description": "Query an instant vector at the application-selected end time.",
      "properties": {
        "expression": {
          "title": "Expression",
          "type": "string",
          "description": "PromQL expression returning an instant vector, using confirmed metric names and label values. Not a bare range vector or scalar."
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string",
          "x-investigation-context": "end",
          "description": "Timezone-aware timestamp at which to evaluate the expression."
        }
      },
      "required": [
        "expression",
        "at"
      ],
      "title": "MetricQuery",
      "type": "object"
    },
    "outputSchema": {
      "$defs": {
        "Evidence": {
          "description": "Observation with its source, time, query provenance, and backend\ndetails.",
          "properties": {
            "id": {
              "format": "uuid",
              "title": "Id",
              "type": "string"
            },
            "source": {
              "$ref": "#/$defs/EvidenceSource"
            },
            "summary": {
              "minLength": 1,
              "title": "Summary",
              "type": "string"
            },
            "observed_at": {
              "format": "date-time",
              "title": "Observed At",
              "type": "string"
            },
            "service": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Service"
            },
            "query": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Query"
            },
            "attributes": {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "title": "Attributes",
              "type": "object"
            }
          },
          "required": [
            "source",
            "summary",
            "observed_at"
          ],
          "title": "Evidence",
          "type": "object"
        },
        "EvidenceSource": {
          "description": "Telemetry source category of a normalized observation.",
          "enum": [
            "metric",
            "trace",
            "log"
          ],
          "title": "EvidenceSource",
          "type": "string"
        },
        "JsonValue": {},
        "RemoteFailure": {
          "additionalProperties": false,
          "description": "Transfer safe retry classification, excluding backend error text.",
          "properties": {
            "category": {
              "title": "Category",
              "type": "string"
            },
            "retryable": {
              "default": false,
              "title": "Retryable",
              "type": "boolean"
            },
            "status_code": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Status Code"
            },
            "retry_after": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Retry After"
            }
          },
          "required": [
            "category"
          ],
          "title": "RemoteFailure",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "description": "Return exactly one observation list, metadata object or safe failure.",
      "properties": {
        "evidence": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Evidence"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence"
        },
        "metadata": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metadata"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/RemoteFailure"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "TelemetryReply",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true
    },
    "_meta": {
      "tracemind/result-contract": "telemetry.v1",
      "tracemind/preview-limit": 50
    }
  },
  {
    "name": "discover_metrics",
    "description": "Discover metric names and label examples in the supplied start/end window before writing PromQL. Use when relevant names or labels are unknown, including after an empty query with suspected mismatches. Reuse previously discovered metadata; skip discovery when names and labels are known or evidence is sufficient.\n\nReturns metrics containing metric, label_keys and example_labels. Empty example_labels means no examples were included, not that the metric has no labels; pass its exact returned name as metric to inspect it. possibly_truncated, omitted_metrics and labels_truncated mark incomplete coverage. Empty discovery may mean service labels differ; bounded global discovery can reveal them. Absence never proves health. Metadata has no evidence IDs or sample values and cannot be cited.\n\nFor example, set service=\"orders\" to find candidates for that service in the supplied window. If retained evidence already supports an explanation request, answer without another query.",
    "inputSchema": {
      "additionalProperties": false,
      "description": "Select a bounded metric-name or label catalogue.",
      "properties": {
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string",
          "x-investigation-context": "start"
        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string",
          "x-investigation-context": "end"
        },
        "service": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service",
          "description": "Exact service value matched against service_name, service or job labels, not a substring or regex. Omit or use null for a bounded global catalogue when these labels are unknown."
        },
        "metric": {
          "anyOf": [
            {
              "maxLength": 240,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric",
          "description": "One exact metric name returned by discovery, not PromQL or a regex. Set it to inspect that metric's label examples; omit or use null to discover distinct metric names first."
        },
        "limit": {
          "default": 20,
          "maximum": 50,
          "minimum": 1,
          "title": "Limit",
          "type": "integer",
          "description": "Maximum distinct names and maximum series inspected per metadata request (1-50, default 20), not an evidence count or time range. Results may be incomplete even at this limit."
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "MetricDiscovery",
      "type": "object"
